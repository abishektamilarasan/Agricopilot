# AgriCopilot Environment Template
# Copy this to .env and fill in your secrets

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=mistral
EMBEDDING_MODEL=nomic-embed-text

# ChromaDB Persistence
CHROMA_PERSIST_DIR=./chroma_db

# Web Search API (Tavily - Free tier: 500 queries/month)
# Sign up: https://tavily.com
# Get your API key and paste below
TAVILY_API_KEY=tvly-YOUR_API_KEY_HERE

# Live market data (India Agmarknet / data.gov.in)
DATA_GOV_IN_API_KEY=your_data_gov_in_key

# API Keys (Optional - for paid services)
# OPENAI_API_KEY=your_openai_key_here
# COHERE_API_KEY=your_cohere_key_here
# HUGGINGFACE_API_KEY=your_huggingface_key_here
# AGROMONITORING_API_KEY=your_agromonitoring_key_here

# Database & External Services (Optional)
# POSTGRES_URL=postgresql://user:password@localhost/agricopilot
# REDIS_URL=redis://localhost:6379

# Application Settings
DEBUG=True
LOG_LEVEL=INFO
WORKERS=4

# Geolocation Defaults
DEFAULT_LAT=20.5937
DEFAULT_LON=78.9629
DEFAULT_CROP=rice
DEFAULT_COUNTRY=India
